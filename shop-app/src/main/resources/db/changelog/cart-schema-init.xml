<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="1750001498119-cart" author="timshowtime">
        <createTable tableName="cart">
            <column name="id" type="int" autoIncrement="true">
                <constraints primaryKey="true"/>
            </column>
            <column name="total_price" type="int"/>
        </createTable>
    </changeSet>

    <changeSet id="1750001498119-cart change id type" author="timshowtimes">
        <modifyDataType tableName="cart" columnName="id" newDataType="bigint"/>
    </changeSet>

    <changeSet id="create user id and add constraint" author="timshowtimes">
        <addColumn tableName="cart">
            <column name="user_id" type="bigint">
                <constraints nullable="false"/>
            </column>
        </addColumn>
        
        <addForeignKeyConstraint baseTableName="cart" baseColumnNames="user_id" 
                                 constraintName="fk_cart_users" 
                                 referencedTableName="users"
                                 referencedColumnNames="id"/>
        
        <addUniqueConstraint tableName="cart" columnNames="user_id"/>
    </changeSet>

</databaseChangeLog>